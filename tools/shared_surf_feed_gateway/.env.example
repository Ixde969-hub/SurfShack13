# Comma-separated HTTPS viewer URLs. Each URL must control a different isolated
# remote browser already logged into the same disposable provider account.
SURF_FEED_SLOT_URLS=https://browser-1.example.invalid/vnc.html?autoconnect=1&resize=remote,https://browser-2.example.invalid/vnc.html?autoconnect=1&resize=remote

# Generate a unique random value of at least 32 characters. Never commit the
# real value. It signs the broker's allocation cookie; it is not a TikTok secret.
SURF_FEED_COOKIE_SECRET=replace-with-a-long-random-value

SURF_FEED_SESSION_TTL_SECONDS=900
SURF_FEED_HEARTBEAT_SECONDS=20
SURF_FEED_COOKIE_SECURE=1

# Optional visual crop around the remote viewer. A mobile browser layout is
# preferred. Cropping is presentation only and is not an access-control boundary.
SURF_FEED_CROP_LEFT_PX=0
SURF_FEED_CROP_RIGHT_PX=0
SURF_FEED_CROP_TOP_PX=0
SURF_FEED_CROP_BOTTOM_PX=0

HOST=0.0.0.0
PORT=8080
